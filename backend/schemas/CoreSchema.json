{
  "$id": "https://qzera.dev/schemas/story/CoreSchema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qzera Story Core Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyId", "meta", "pages"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "title": "Schema version (SemVer)",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "storyId": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "coverImage": { "type": "string" },
        "logo": {
          "type": "string",
          "description": "Story / brand logo asset path (ugyanaz, amit a header + MediaFrame használ)."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ctaPresets": {
          "description": "Globális CTA presetek, kulcs: presetId (pl. 'default').",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/CtaPreset" }
        },
        "endDefaultCta": {
          "description": "Alapértelmezett CTA preset az end / finálé oldalhoz.",
          "type": "string",
          "minLength": 1
        },
        "startPageId": { "type": "string" },
        "campaignId": { "type": "string" },
        "defaultFallbackMessage": {
          "type": "string",
          "description": "Statikus üzenet, ha node matching bizonytalan és nincs node-szintű fallback_message."
        },
        "runtime": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mock_today": {
              "type": "string",
              "description": "ISO dátum (pl. 2026-05-15) — derive_conditions alapértelmezett „ma” mock tesztekhez."
            },
            "return_window_days": {
              "type": "integer",
              "minimum": 1,
              "description": "Visszaküldési ablak napokban (derive_conditions)."
            }
          }
        },
        "reply_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global_rules": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Stílusszabályok — minden reply LLM hívás system promptjába kerülnek."
            },
            "ack_and_paragraph_instruction": {
              "type": "string",
              "description": "Nyugtázási és bekezdés-formázási instrukció a reply LLM-nek."
            }
          }
        },
        "order_context_mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "precedence_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "if_present": { "type": "string" },
                  "suppress": { "type": "string" }
                },
                "required": ["if_present", "suppress"]
              }
            },
            "field_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": { "type": "string" },
                  "condition": { "type": "string" },
                  "when": {
                    "type": "string",
                    "enum": ["truthy", "not_null"]
                  },
                  "when_value": {},
                  "when_any_value": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "requires_field_not_null": { "type": "string" },
                  "requires_field_lt_today": { "type": "string" },
                  "session_guard_not": { "type": "string" }
                },
                "required": ["field", "condition"]
              }
            },
            "session_state_keys": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "computed_condition_ids": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "transition",
              "voice",
              "sfxPlaylist",
              "layoutHints",
              "globalUI",
              "runes",
              "fragments",
              "puzzle"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "fragments": {
      "description": "Global fragment bank (object map formátum, runtime kompatibilis).",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/FragmentDef" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Page" }
    },
    "layout": {},
    "globalUI": {},
    "x-notes": {},
    "x-*": {}
  },
  "patternProperties": {
    "^x-.*$": {}
  },
  "$defs": {
    "Page": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "minItems": 0,
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "$ref": "#/$defs/TextBlock" }
                ]
              }
            }
          ]
        },
        "next": { "$ref": "#/$defs/Next" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/Choice" }
        },
        "fragments": {
          "type": "array",
          "items": { "$ref": "#/$defs/FragmentRef" },
          "uniqueItems": true
        },
        "runes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "voicePrompt": { "$ref": "#/$defs/VoicePrompt" },
        "sfxPlaylist": {
          "type": "array",
          "items": { "$ref": "#/$defs/SfxEvent" }
        },
        "imagePrompt": { "$ref": "#/$defs/ImagePrompt" },
        "imagePromptMerge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "exclude": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "imageTiming": { "$ref": "#/$defs/ImageTiming" },
        "reward": { "$ref": "#/$defs/Reward" },
        "type": {
          "type": "string",
          "enum": ["default", "transition", "puzzle", "decision", "fragmentRecall", "end", "logic", "puzzleOutcomeLogic", "scorecard", "conditionalRouting", "ai"],
          "default": "default"
        },
        "title": { "type": "string" },
        "scorecardFallback": {
          "description": "Ha egyik scorecard/logic tömbös szabály sem illeszkedik, ide ugrik (opcionális).",
          "type": "string",
          "minLength": 1
        },
        "logic": {
          "description": "Logic routing: array of if/goto rules (coffee style) or ifHasFragment/elseGoTo object (Mrk6 style).",
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/LogicRule" }
            },
            { "$ref": "#/$defs/LogicObject" }
          ]
        },
        "layout": {},
        "globalUI": {},
        "x-notes": {},
        "x-*": {}
      },
      "patternProperties": {
        "^x-.*$": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "transition" } } },
          "then": { "$ref": "#/$defs/TransitionPage" }
        },
        {
          "if": { "properties": { "type": { "const": "puzzle" } } },
          "then": { "$ref": "#/$defs/PuzzlePage" }
        },
        {
          "if": { "properties": { "type": { "const": "fragmentRecall" } } },
          "then": { "$ref": "#/$defs/FragmentRecallPage" }
        },
        {
          "if": { "properties": { "type": { "const": "ai" } } },
          "then": { "$ref": "#/$defs/AiNode" }
        }
      ]
    },
    "Next": {
      "description": "Either a direct pageId (string) or a switch-based router object.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/NextSwitch" }
      ]
    },
    "NextSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["switch", "cases"],
      "properties": {
        "switch": { "type": "string", "minLength": 1 },
        "cases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "string", "minLength": 1 }
      }
    },
    "Choice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "nextPageId": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 },
        "lockedIf": { "type": "string" },
        "hideIfHasFragment": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "showIfHasFragment": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "reward": { "$ref": "#/$defs/Reward" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Action" }
        },
        "analytics": { "type": "object" },
        "extras": { "type": "object" },
        "x-*": {}
      },
      "anyOf": [
        { "required": ["label"] },
        { "required": ["text"] }
      ],
      "patternProperties": {
        "^x-.*$": {}
      }
    },
    "Action": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "setFlag" },
            "flag": { "type": "string" },
            "id": { "type": "string" },
            "value": {}
          },
          "anyOf": [
            { "required": ["type", "flag"] },
            { "required": ["type", "id"] }
          ]
        },
        {
          "properties": {
            "type": { "const": "unlockFragment" },
            "fragmentId": { "type": "string" }
          },
          "required": ["type", "fragmentId"]
        },
        {
          "properties": {
            "type": { "const": "lock" },
            "key": { "type": "string" }
          },
          "required": ["type", "key"]
        },
        {
          "properties": {
            "type": { "const": "unlock" },
            "key": { "type": "string" }
          },
          "required": ["type", "key"]
        }
      ]
    },
    "Reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setGlobal": {
          "type": "object",
          "additionalProperties": true
        },
        "locks": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "unlocks": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "unlockFragments": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "FragmentDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "replayImage": { "type": "string" },
        "imagePromptParts": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "global": { "type": "string" },
                "chapter": { "type": "string" },
                "page": { "type": "string" },
                "combinedPrompt": { "type": "string" },
                "negative": { "type": "string" },
                "negativePrompt": { "type": "string" }
              }
            }
          ]
        },
        "extras": { "type": "object" },
        "x-*": {}
      },
      "patternProperties": {
        "^x-.*$": {}
      }
    },
    "FragmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "extras": { "type": "object" }
      }
    },
    "TextBlock": {
      "description": "Feltételes vagy kiegészítő szövegblokk (ifUnlocked/default stb.).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "default": { "type": "string" },
        "ifUnlocked": { "type": "string" },
        "mode": { "type": "string" },
        "separator": { "type": "string" }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["default"] }
      ]
    },
    "VoicePrompt": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "voice": { "type": "string" },
            "lang": { "type": "string" }
          }
        }
      ]
    },
    "SfxEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atMs", "src"],
      "properties": {
        "atMs": { "type": "integer", "minimum": 0 },
        "src": { "type": "string", "minLength": 1 },
        "gainDb": { "type": "number" },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duckToDb": { "type": "number" },
            "attackMs": { "type": "integer", "minimum": 0 },
            "releaseMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ImagePrompt": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": { "type": "string" },
            "chapter": { "type": "string" },
            "page": { "type": "string" },
            "combinedPrompt": { "type": "string" },
            "negativePrompt": { "type": "string" },
            "styleProfile": { "type": "string" },
            "seed": { "type": "integer" }
          }
        }
      ]
    },
    "ImageTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generate": { "type": "boolean" },
        "on": { "type": "string", "enum": ["pageEnter", "afterVoice"] }
      }
    },
    "TransitionPage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["video", "fog", "cut"] },
            "src": { "type": "string" },
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "PuzzlePage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["runes", "riddle"] },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "answer": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "maxAttempts": { "type": "integer", "minimum": 1 }
      }
    },
    "FragmentRecallPage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fragmentRecall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "showImage": { "type": "boolean" }
          }
        }
      }
    },
    "AiNodeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": false },
        "do_not_reask_if_satisfied": { "type": "boolean", "default": false },
        "do_not_reask_hint": {
          "type": "string",
          "description": "Ha megadva: ez a szöveg kerül a reply LLM instrukciójába az általános szabály helyett/mellett, ha a kondíció teljesült."
        },
        "text_triggers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Magyar frázisok — ha bármelyik illeszkedik a user üzenetére (ékezet-normalizálva), a kondíció determinisztikusan teljesül."
        },
        "trigger_default_if_no_outcome": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trigger_default_fallback": { "type": "string" }
      }
    },
    "AiNodeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "ai_action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "ai_action": { "type": "string", "minLength": 1 },
        "reply_rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extract_hint": {
          "type": "string",
          "description": "Opcionális szöveg, amit a runtime az extract_conditions promptba fűz — node ID hardcode nélkül."
        },
        "internal_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/AiNodeCondition" }
        },
        "done_when": { "type": "string" },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["if"],
            "properties": {
              "if": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "next_step": { "type": "string" },
              "goto": { "type": "string" },
              "message": { "type": "string" },
              "inject_conditions": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "anyOf": [
              { "required": ["next_step"] },
              { "required": ["goto"] }
            ]
          }
        },
        "default_next": { "type": ["string", "null"] },
        "skip_backfill": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["if_any", "then"],
            "properties": {
              "if_any": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Ha ezek közül bármelyik teljesült a session-ben..."
              },
              "requires": {
                "type": "array",
                "items": { "type": "string" },
                "description": "...és ezek mind teljesültek..."
              },
              "then": {
                "type": "string",
                "description": "...akkor ezt a kondíciót teljesíti skip során."
              }
            }
          }
        },
        "late_image_backfill": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when_all", "then"],
            "properties": {
              "when_all": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Ha ezek mind teljesültek a session-ben..."
              },
              "then": {
                "type": "string",
                "description": "...és kép érkezett, akkor ezt a kondíciót teljesíti."
              }
            }
          }
        }
      }
    },
    "AiNodeRoutingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "if": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "goto": { "type": "string", "minLength": 1 },
        "default": { "type": "string", "enum": ["ask", "goto"] }
      },
      "oneOf": [
        { "required": ["if", "goto"] },
        { "required": ["default"] }
      ]
    },
    "AiNode": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "scope": { "type": "string" },
            "examples": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AiNodeCondition" },
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/AiNodeStep" }
        },
        "routing": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AiNodeRoutingRule" }
        },
        "fallback_message": {
          "type": "string",
          "description": "Opcionális statikus assistantMessage, ha a node matching askClarification és nincs modell assistantMessage."
        }
      }
    },
    "LogicRule": {
      "description": "Egy feltételes ugrás: ha minden megadott lock/fragment igaz, menj a goto oldalra.",
      "type": "object",
      "additionalProperties": false,
      "required": ["if", "goto"],
      "properties": {
        "if": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "goto": { "type": "string", "minLength": 1 }
      }
    },
    "LogicIfHasFragment": {
      "description": "Fragment alapú elágazás egy eleme: ha a fragment megvan, menj a goTo oldalra.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment", "goTo"],
      "properties": {
        "fragment": { "type": "string", "minLength": 1 },
        "goTo": { "type": "string", "minLength": 1 }
      }
    },
    "LogicObject": {
      "description": "Objektum formátumú logic: ifHasFragment listával és opcionális elseGoTo.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifHasFragment": {
          "type": "array",
          "items": { "$ref": "#/$defs/LogicIfHasFragment" }
        },
        "elseGoTo": { "type": "string", "minLength": 1 }
      }
    },
    "CtaPreset": {
      "description": "CTA preset definíció (pl. link gomb).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "type": "string", "enum": ["link"] },
        "label": { "type": "string", "minLength": 1 },
        "urlTemplate": {
          "description": "Cél URL vagy templét (pl. query paramokkal).",
          "type": "string",
